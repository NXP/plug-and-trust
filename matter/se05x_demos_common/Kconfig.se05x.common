mainmenu "SE05X examples"

# Secure Element
config CHIP_SE05X
	bool "Enable Secure Element support"
	select SE05X_LIB
	select MCUX_COMPONENT_middleware.mbedtls3x if SE05X_SCP03 || SE05X_USER_ID || SE05X_AES_KEY || SE05X_EC_KEY || SE05X_SCP03_USER_ID || SE05X_SCP03_AES_KEY || SE05X_SCP03_EC_KEY
	help
		Use Secure Element to perform crypto operations.

# Include defaults for SDK Kconfig
config MCUX_PRJSEG_module.board.use_board_clock
    bool
    default n

config MCUX_HAS_PRJSEG_module.board.pinmux_sel
    bool
    default n

choice MCUX_PRJSEG_module.board.pinmux_sel
    default MCUX_PRJSEG_module.board.pinmux_customize_folder
endchoice

config MCUX_HAS_PRJSEG_project.use_hw_app
    bool
    default n

choice MCUX_PRJSEG_project.hw_app_sel
    default MCUX_PRJSEG_project.hw_app_customize_folder
endchoice

config MCUX_COMPONENT_SIMW_LIB_MODULE
   default y if CHIP_SE05X
   default n

config MATTER_DEFAULT_LINKER_FILE_PATH
	string "Default linker file path for Matter applications"
	default "$(CHIP_ROOT)/third_party/nxp/nxp_matter_support/examples/platform/rt/rw61x/app/ldscripts/RW610_flash.ld" if MCUX_HW_DEVICE_RW612 || MCUX_HW_DEVICE_RW610
	default "$(CHIP_ROOT)/third_party/nxp/nxp_matter_support/examples/platform/rt/rt1060/app/ldscripts/MIMXRT1062xxxxx_flexspi_nor.ld" if MCUX_HW_DEVICE_MIMXRT1062
	default "${SdkRootDirPath}/examples/_boards/frdmmcxw72/wireless_examples/linker/gcc/connectivity.ld" if MCUX_HW_DEVICE_MCXW727C
	help
		Defines the path to the linker file to use.

config CHIP_NXP_RT1060_SDK_DEPENDENCIES
    bool "RT1060 SDK DEPENDENCIES"
    depends on MCUX_HW_DEVICE_MIMXRT1061 || MCUX_HW_DEVICE_MIMXRT1062
	default y
	select MCUX_COMPONENT_component.timer_manager
	select MCUX_COMPONENT_component.igpio_adapter
	select MCUX_COMPONENT_driver.edma
	select MCUX_COMPONENT_middleware.sdmmc.common
	select MCUX_COMPONENT_middleware.sdmmc.host.usdhc
	select MCUX_COMPONENT_middleware.sdmmc.sdio
	select MCUX_COMPONENT_component.wifi_bt_module.config
	select MCUX_COMPONENT_middleware.mbedtls3x.port.tfm # Required for entropy
    help
        NXP RT1060 platform sdk dependencies.

config CHIP_NXP_RW612_SDK_DEPENDENCIES
    bool "RW612 SDK DEPENDENCIES"
    depends on MCUX_HW_DEVICE_RW612 || MCUX_HW_DEVICE_RW610
	default y
	select MCUX_COMPONENT_middleware.freertos-kernel.cm33_non_trustzone
	select MCUX_COMPONENT_middleware.mbedtls3x.port.tfm # Required for entropy
    help
        NXP RW612 platform sdk dependencies.

config CHIP_NXP_PLATFORM_RW61X
	bool "RW61x platform"
	depends on MCUX_HW_DEVICE_RW612 || MCUX_HW_DEVICE_RW610
	default y
	help
		NXP RW61x platform.

config CHIP_NXP_PLATFORM_MCXW72
	bool "mcxw72 platform"
	depends on MCUX_HW_DEVICE_MCXW727C
	default y
	help
		NXP mcxw72 platform.

config CHIP_NXP_MCXW72_SDK_DEPENDENCIES
    bool "MCXW72 SDK DEPENDENCIES"
    depends on MCUX_HW_DEVICE_MCXW727C
	default y
	select MCUX_COMPONENT_middleware.freertos-kernel.cm33_non_trustzone
	select MCUX_COMPONENT_component.led
	select MCUX_COMPONENT_component.button
	select MCUX_COMPONENT_component.timer_manager
	select MCUX_COMPONENT_component.gpio_adapter
	select MCUX_COMPONENT_component.lptmr_time_stamp_adapter
	select MCUX_COMPONENT_driver.lpspi
	select MCUX_COMPONENT_middleware.wireless.ble_host
	select MCUX_COMPONENT_middleware.wireless.framework
	select MCUX_COMPONENT_component.messaging
	select MCUX_COMPONENT_middleware.wireless.framework.seclib_rng
	select MCUX_COMPONENT_middleware.wireless.framework.module_info
	select MCUX_COMPONENT_middleware.wireless.framework.function_lib
	select MCUX_COMPONENT_middleware.wireless.framework.module_info
	select MCUX_COMPONENT_middleware.wireless.framework.hw_parameter
	select MCUX_COMPONENT_middleware.wireless.framework.lowpower
	select MCUX_COMPONENT_middleware.wireless.framework.workq
	select MCUX_COMPONENT_middleware.mbedtls3x
	select MCUX_COMPONENT_component.flash_nor_lpspi
	select MCUX_COMPONENT_middleware.mbedtls3x.port.tfm # Required for entropy
	select MCUX_COMPONENT_component.psa_crypto_driver.ele_s200
    help
        NXP MCXW72 platform sdk dependencies.

config CHIP_SDK_DEPENDENCIES_BLE_HOST
	bool "SDK dependencies for BLE host implementation"
	default y if CHIP_NXP_PLATFORM_MCXW72
	help
	    SDK dependencies for BLE host implementation.

config MCUX_PRJSEG_module.board.matter.board
	bool "Enable board files"
	default y
	help
		Enables the inclusion of board files in the application build.

config CHIP_NXP_PLATFORM_RT1060
	bool "RT1060 platform"
	depends on MCUX_HW_DEVICE_MIMXRT1061 || MCUX_HW_DEVICE_MIMXRT1062
	default y
	help
		NXP RT1060 platform.

config CHIP_WIFI
	bool "Enable Wi-Fi support"
	default y if MCUX_HW_BOARD_evkcmimxrt1060
	help
		Enable Wi-Fi support.

# Enable IW61X transceiver by default
choice MCUX_DEPENDENCY_COMPONENT_component.wifi_bt_module.selection
	default MCUX_COMPONENT_component.wifi_bt_module.IW61X if MCUX_HW_BOARD_evkcmimxrt1060
endchoice

#IW612 transceiver module type
if MCUX_COMPONENT_component.wifi_bt_module.IW61X
choice IW61X_MDOULE
	default MCUX_COMPONENT_component.wifi_bt_module.board_murata_2el_m2
endchoice
endif

config CHIP_NXP_PLATFORM_FOLDER_NAME
	string "NXP platform folder name"
	default "rt/rw61x" if MCUX_HW_DEVICE_RW612 || MCUX_HW_DEVICE_RW610
	default "rt/rt1060" if MCUX_HW_DEVICE_MIMXRT1061 || MCUX_HW_DEVICE_MIMXRT1062
	default "mcxw72" if MCUX_HW_DEVICE_MCXW727C
	help
		Defines the platform folder name to be used.
# FreeRTOS defaults
config configTICK_RATE_HZ
	default 1000

config configMAX_PRIORITIES
	default 10

config configRUN_FREERTOS_SECURE_ONLY
	default y

config configTIMER_QUEUE_LENGTH
	default 10

config configAPPLICATION_ALLOCATED_HEAP
	default y

config configCHECK_FOR_STACK_OVERFLOW
	default y

config configTIMER_TASK_PRIORITY
	default "(configMAX_PRIORITIES - 3)"

config configTOTAL_HEAP_SIZE
	default 129024

config configMINIMAL_STACK_SIZE
	default 2048

# This Kconfig requires quotes "" due to its definition as a string
config configTIMER_TASK_STACK_DEPTH
	default "2048"

config configRECORD_STACK_HIGH_ADDRESS
	default y

config configINCLUDE_FREERTOS_TASK_C_ADDITIONS_H
	default y

config configENABLE_FPU
	default y

config configMAX_TASK_NAME_LEN
	default 16

config configSUPPORT_STATIC_ALLOCATION
	default y

config configNUM_THREAD_LOCAL_STORAGE_POINTERS
	default 0

config configSTACK_DEPTH_TYPE
	default "StackType_t"

config INCLUDE_uxTaskGetStackHighWaterMark2
	default n

config INCLUDE_xTaskGetIdleTaskHandle
	default n

config INCLUDE_eTaskGetState
	default n

config INCLUDE_xTaskGetHandle
	default n

config configKERNEL_PROVIDED_STATIC_MEMORY
	default y

if SE05X_SCP03 || SE05X_USER_ID || SE05X_AES_KEY || SE05X_EC_KEY || SE05X_SCP03_USER_ID || SE05X_SCP03_AES_KEY || SE05X_SCP03_EC_KEY || MCUX_HW_DEVICE_MCXW727C
	choice MCUX_COMPONENT_middleware.mbedtls.port.selection
		default MCUX_COMPONENT_middleware.mbedtls.port.els_pkc if MCUX_HW_DEVICE_RW612 || MCUX_HW_DEVICE_RW610
		default MCUX_COMPONENT_middleware.mbedtls.port.ksdk if MCUX_HW_DEVICE_MIMXRT1061 || MCUX_HW_DEVICE_MIMXRT1062
		default MCUX_COMPONENT_middleware.mbedtls.port.sssapi if MCUX_HW_DEVICE_MCXW716C || MCUX_HW_DEVICE_MCXW727C
	endchoice
endif

source "Kconfig.mcuxpresso"