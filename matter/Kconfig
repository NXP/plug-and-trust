# Secure Element
config SE05X_LIB
	bool "Enable Secure Element library"
	select MCUX_COMPONENT_driver.flexcomm_i2c if MCUX_HW_DEVICE_RW612 || MCUX_HW_DEVICE_RW610
	select MCUX_COMPONENT_driver.flexcomm_i2c_freertos if MCUX_HW_DEVICE_RW612 || MCUX_HW_DEVICE_RW610
	select MCUX_COMPONENT_driver.lpi2c if MCUX_HW_DEVICE_MIMXRT1062 || MCUX_HW_DEVICE_MCXW727C
	select MCUX_COMPONENT_driver.lpi2c_freertos if MCUX_HW_DEVICE_MIMXRT1062 || MCUX_HW_DEVICE_MCXW727C
	help
		Use Secure Element library

if SE05X_LIB

config NXP_CRYPTO_IMPL
	string "NXP SE05X Crypto Implementation"
	default "se05x"
	help
		Defines crypto implementation to be used

config SE05X_SCP03
	bool "Enable platform SCP03 authenticated session with SE05x"
	depends on SE05X_LIB
	help
		To enable platform SCP03 authenticated session with SE05x

config SE05X_USER_ID
	bool "Enable User ID authenticated session with SE05x"
	depends on SE05X_LIB
	help
		To enable User ID authenticated session with SE05x

config SE05X_AES_KEY
	bool "Enable AES Key authenticated session with SE05x"
	depends on SE05X_LIB
	help
		To enable AES Key authenticated session with SE05x

config SE05X_EC_KEY
	bool "Enable EC Key authenticated session with SE05x"
	depends on SE05X_LIB
	help
		To enable EC Key authenticated session with SE05x

config SE05X_SCP03_USER_ID
	bool "Enable SCP03 + USer ID authenticated session with SE05x"
	depends on SE05X_LIB
	help
		To enable SCP03 + USer ID authenticated session with SE05x

config SE05X_SCP03_AES_KEY
	bool "Enable SCP03 + AES Key authenticated session with SE05x"
	depends on SE05X_LIB
	help
		To enable SCP03 + AES Key authenticated session with SE05x

config SE05X_SCP03_EC_KEY
	bool "Enable SCP03 + EC Key authenticated session with SE05x"
	depends on SE05X_LIB
	help
		To enable SCP03 + EC Key authenticated session with SE05x

config SE05X_HOST_GPIO
	bool "Host controller SE05x GPIO enablement"
	depends on MCUX_HW_DEVICE_RW612 || MCUX_HW_DEVICE_RW610 || MCUX_HW_DEVICE_MIMXRT1062
	help
		NXP Host controller SE05x GPIO enablement

endif # SE05X_LIB
